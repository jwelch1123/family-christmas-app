<%- include('partials/head', { title: 'Log in' }) %>
<div class="card login">
  <h1>Welcome back 🎄</h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/login" class="stack">
    <label>Email <input name="email" type="email" value="<%= email %>" autocomplete="username" autocapitalize="off" required></label>
    <label>PIN <input name="pin" type="password" inputmode="numeric" pattern="[0-9]*" autocomplete="current-password" required></label>
    <button class="btn primary wide">Log in</button>
  </form>
  <p class="muted small center">New here? Ask someone in your family for an invite link.<br>Forgot your PIN? Ask the site admin for a reset link.</p>
</div>
<%- include('partials/foot') %>
