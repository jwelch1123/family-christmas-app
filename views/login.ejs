<%- include('partials/head', { title: 'Log in' }) %>
<div class="card login">
  <h1>Who are you?</h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/login" id="login-form">
    <div class="name-grid">
      <% users.forEach(u => { %>
        <label class="name-pick">
          <input type="radio" name="user_id" value="<%= u.id %>" data-has-pin="<%= u.has_pin %>" <%= selected === u.id ? 'checked' : '' %> required>
          <span><%= u.name %></span>
        </label>
      <% }) %>
    </div>

    <div class="login-fields" hidden>
      <div class="first-time" hidden>
        <p class="hint">First time here! Enter the family code and pick a PIN you'll remember.</p>
        <label>Family code <input name="family_code" autocomplete="off" autocapitalize="off"></label>
      </div>
      <label>PIN <input name="pin" type="password" inputmode="numeric" pattern="[0-9]*" autocomplete="current-password" required></label>
      <label class="first-time" hidden>Confirm PIN <input name="pin_confirm" type="password" inputmode="numeric" pattern="[0-9]*" autocomplete="new-password"></label>
      <button class="btn primary wide">Let me in</button>
    </div>
  </form>
</div>
<%- include('partials/foot') %>
