<%- include('partials/head', { title: person.name }) %>

<div class="page-head">
  <a class="back" href="/">‹ Home</a>
  <h1><%= isOwner ? 'My lists' : person.name + "'s lists" %></h1>
  <% if (isOwner) { %>
    <p class="muted small">Add ideas below. Claims and comments from others are hidden from you, so the surprise is safe. 🤫</p>
  <% } else { %>
    <p class="muted small">Claims and comments are hidden from <%= person.name %>. You only see comments from people in your groups.</p>
  <% } %>
</div>

<% if (!lists.length) { %>
  <div class="card center muted"><%= isOwner ? "You don't have any lists yet." : person.name + " hasn't shared any lists with your groups yet." %></div>
<% } %>

<% lists.forEach(list => { %>
  <section class="card list <%= list.kind %>" id="list-<%= list.id %>">
    <div class="list-head">
      <h2><% if (list.kind === 'interests') { %><span class="kind-icon" aria-hidden="true">💭</span><% } %><%= list.title %></h2>
      <% if (isOwner) { %>
        <button type="button" class="icon-btn" data-toggle="list-menu-<%= list.id %>" aria-label="List options" aria-expanded="false">⋯</button>
      <% } %>
    </div>
    <% if (isOwner) {
         const shared = groups.filter(g => list.sharedWith.has(g.id)); %>
      <p class="shared-with small <%= shared.length ? '' : 'private' %>">
        <%= shared.length ? '👥 ' + shared.map(g => g.name).join(', ') : '🔒 Only you can see this list' %>
      </p>
          <div class="menu-body" id="list-menu-<%= list.id %>" hidden>
            <% if (groups.length) { %>
              <form method="post" action="/lists/<%= list.id %>/share" class="stack">
                <strong class="small">Who can see this list?</strong>
                <div class="checks">
                  <% groups.forEach(g => { %>
                    <label class="check"><input type="checkbox" name="group_ids" value="<%= g.id %>" <%= list.sharedWith.has(g.id) ? 'checked' : '' %>> <%= g.name %></label>
                  <% }) %>
                </div>
                <button class="btn">Save sharing</button>
              </form>
            <% } %>
            <form method="post" action="/lists/<%= list.id %>/rename" class="row">
              <input name="title" value="<%= list.title %>" maxlength="80" aria-label="List name" required>
              <button class="btn">Rename</button>
            </form>
            <form method="post" action="/lists/<%= list.id %>/delete" data-confirm="Delete “<%= list.title %>” and everything on it?">
              <button class="btn danger wide">Delete list</button>
            </form>
          </div>
    <% } %>

    <% if (list.kind === 'interests') { %>
      <% if (list.body) { %>
        <div class="freeform"><%- linkify(list.body) %></div>
      <% } else { %>
        <p class="muted empty"><%= isOwner ? 'General ideas: hobbies, things you\'re exploring, stores you love.' : 'Nothing here yet.' %></p>
      <% } %>
      <% if (isOwner) { %>
        <details class="add-item">
          <summary class="btn wide"><%= list.body ? '✎ Edit' : '✎ Add general ideas' %></summary>
          <form method="post" action="/lists/<%= list.id %>/body" class="stack">
            <textarea name="body" rows="6" maxlength="5000" aria-label="<%= list.title %>" placeholder="Sourdough baking&#10;Trail running — need a better headlamp&#10;Anything from https://example.com"><%= list.body || '' %></textarea>
            <button class="btn primary">Save</button>
          </form>
        </details>
      <% } else { %>
        <%- include('partials/comments', { comments: list.comments, action: `/lists/${list.id}/comments`, placeholder: 'e.g. I\'m getting a class for this — anyone want in?' }) %>
      <% } %>
    <% } else { %>
    <% if (!list.items.length) { %>
      <p class="muted empty"><%= isOwner ? 'Specific items: things with a link that people can claim.' : 'Nothing on this list yet.' %></p>
    <% } %>

    <ul class="items">
      <% list.items.forEach(item => {
           const claimedByMe = item.claim && item.claim.label === 'me'; %>
        <li class="item <%= item.claim ? (claimedByMe ? 'claimed mine' : 'claimed') : '' %>" id="item-<%= item.id %>">
          <div class="item-main">
            <div class="item-title">
              <% if (item.starred) { %><span class="star" title="Really wants this">★</span><% } %>
              <% if (item.url) { %>
                <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer"><%= item.title %></a>
              <% } else { %>
                <span><%= item.title %></span>
              <% } %>
            </div>
            <% if (item.url) { %>
              <a class="host" href="<%= item.url %>" target="_blank" rel="noopener noreferrer">🔗 <%= hostOf(item.url) %></a>
            <% } %>
            <% if (item.notes) { %><p class="notes"><%- linkify(item.notes) %></p><% } %>
          </div>

          <% if (isOwner) { %>
            <div class="item-actions">
              <form method="post" action="/items/<%= item.id %>/star">
                <button class="icon-btn <%= item.starred ? 'on' : '' %>" aria-label="<%= item.starred ? 'Unstar' : 'Star as a favorite' %>"><%= item.starred ? '★' : '☆' %></button>
              </form>
              <button type="button" class="icon-btn" data-toggle="edit-<%= item.id %>" aria-label="Edit item" aria-expanded="false">✎</button>
            </div>
                <div class="menu-body" id="edit-<%= item.id %>" hidden>
                  <form method="post" action="/items/<%= item.id %>/edit" class="stack">
                    <label>What <input name="title" value="<%= item.title %>" maxlength="200"></label>
                    <label>Link <input name="url" type="text" inputmode="url" autocapitalize="off" autocorrect="off" value="<%= item.url || '' %>" placeholder="https://…"></label>
                    <label>Notes <textarea name="notes" rows="2" maxlength="1000" placeholder="Size, color, etc."><%= item.notes || '' %></textarea></label>
                    <button class="btn primary">Save</button>
                  </form>
                  <form method="post" action="/items/<%= item.id %>/delete" data-confirm="Remove “<%= item.title %>”?">
                    <button class="btn danger wide">Remove</button>
                  </form>
                </div>
          <% } else { %>
            <div class="claim-row">
              <% if (!item.claim) { %>
                <form method="post" action="/items/<%= item.id %>/claim">
                  <button class="btn primary small">🎁 I'll get this</button>
                </form>
              <% } else if (claimedByMe) { %>
                <span class="pill mine">✓ You're giving this</span>
                <form method="post" action="/items/<%= item.id %>/unclaim" data-confirm="Release this so someone else can claim it?">
                  <button class="link-btn danger">Release</button>
                </form>
              <% } else { %>
                <span class="pill">✓ <%= item.claim.label ? 'Claimed by ' + item.claim.label : 'Held by someone outside your groups' %></span>
              <% } %>
            </div>

            <%- include('partials/comments', { comments: item.comments, action: `/items/${item.id}/comments`, placeholder: 'e.g. Want to go in on this together?' }) %>
          <% } %>
        </li>
      <% }) %>
    </ul>

    <% if (isOwner) { %>
      <details class="add-item">
        <summary class="btn wide">＋ Add specific items</summary>
        <form method="post" action="/lists/<%= list.id %>/items" class="stack">
          <label>What <input name="title" maxlength="200" placeholder="Cozy socks"></label>
          <label>Link <span class="muted">(optional)</span> <input name="url" type="text" inputmode="url" autocapitalize="off" autocorrect="off" placeholder="Paste a link"></label>
          <label>Notes <span class="muted">(optional)</span> <textarea name="notes" rows="2" maxlength="1000" placeholder="Size, color, etc."></textarea></label>
          <button class="btn primary">Add to list</button>
        </form>
      </details>
    <% } %>
    <% } %>
  </section>
<% }) %>

<% if (isOwner) { %>
  <details class="card add-list">
    <summary>＋ New list</summary>
    <form method="post" action="/lists" class="stack" id="new-list">
      <div class="kind-pick">
        <label>
          <input type="radio" name="kind" value="gifts" checked>
          <span><strong>🎁 Gift list</strong><small>Specific things with links. Others can claim them.</small></span>
        </label>
        <label>
          <input type="radio" name="kind" value="interests">
          <span><strong>💭 Interests</strong><small>Free-form notes on what you're into or exploring.</small></span>
        </label>
      </div>
      <label>Name
        <input name="title" maxlength="80" placeholder="e.g. Books, Big-ticket, Stocking stuffers">
      </label>
      <div class="suggestions" data-for="interests" hidden>
        <% ["I'm interested in…", 'Exploring…', 'Into lately…', 'Always happy to get…'].forEach(t => { %>
          <button type="button" class="chip" data-title="<%= t %>"><%= t %></button>
        <% }) %>
      </div>
      <div class="suggestions" data-for="gifts">
        <% ['Books', 'Stocking stuffers', 'Big-ticket', 'Clothes'].forEach(t => { %>
          <button type="button" class="chip" data-title="<%= t %>"><%= t %></button>
        <% }) %>
      </div>
      <button class="btn primary">Create list</button>
    </form>
  </details>
<% } %>

<%- include('partials/foot') %>
